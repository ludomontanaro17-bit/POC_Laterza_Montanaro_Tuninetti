<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loan Approval Predictor</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .feature-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
        }
        .result-section {
            display: none;
            background: #e9ecef;
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
        }
        .probability-bar {
            height: 25px;
            background: linear-gradient(90deg, #dc3545, #ffc107, #28a745);
            border-radius: 5px;
            margin: 10px 0;
            position: relative;
        }
        .probability-value {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            font-weight: bold;
            color: #000;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <div class="row">
            <div class="col-12">
                <h1 class="text-center mb-4">🏠 Loan Approval Predictor</h1>
                <p class="text-center text-muted">Inserisci i dati per prevedere l'approvazione del prestito</p>
            </div>
        </div>

        <form id="predictionForm">
            <!-- Informazioni Personali -->
            <div class="feature-section">
                <h3>👤 Informazioni Personali</h3>
                <div class="row">
                    <div class="col-md-4">
                        <label class="form-label">Gender</label>
                        <select class="form-select" name="Gender_Male" required>
                            <option value="0">Femmina</option>
                            <option value="1">Maschio</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Stato Civile</label>
                        <select class="form-select" name="Married_Yes" required>
                            <option value="0">Non Sposato</option>
                            <option value="1">Sposato</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Istruzione</label>
                        <select class="form-select" name="Education_Not Graduate" required>
                            <option value="0">Laureato</option>
                            <option value="1">Non Laureato</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Informazioni Finanziarie -->
            <div class="feature-section">
                <h3>💰 Informazioni Finanziarie</h3>
                <div class="row">
                    <div class="col-md-3">
                        <label class="form-label">Reddito Richiedente (€)</label>
                        <input type="number" class="form-control" id="ApplicantIncome" min="0" step="100" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Reddito Co-richiedente (€)</label>
                        <input type="number" class="form-control" id="CoapplicantIncome" min="0" step="100" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Importo Prestito (€)</label>
                        <input type="number" class="form-control" name="LoanAmount" min="0" step="1000" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Durata Prestito (mesi)</label>
                        <input type="number" class="form-control" name="Loan_Amount_Term" min="0" step="12" required>
                    </div>
                </div>
            </div>

            <!-- Informazioni Aggiuntive -->
            <div class="feature-section">
                <h3>📊 Informazioni Aggiuntive</h3>
                <div class="row">
                    <div class="col-md-3">
                        <label class="form-label">Numero Dipendenti</label>
                        <input type="number" class="form-control" name="Dependents" min="0" max="10" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Storia Creditizia</label>
                        <select class="form-select" name="Credit_History" required>
                            <option value="0">Scarsa</option>
                            <option value="1">Buona</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Lavoratore Autonomo</label>
                        <select class="form-select" name="Self_Employed_Yes" required>
                            <option value="0">No</option>
                            <option value="1">Sì</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Area Proprietà</label>
                        <select class="form-select" name="Property_Area" required>
                            <option value="Rural">Rurale</option>
                            <option value="Semiurban">Semi-Urbana</option>
                            <option value="Urban">Urbana</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-primary btn-lg"> Prevedi Approvazione Prestito</button>
            </div>
        </form>

        <!-- Risultati -->
        <div id="resultSection" class="result-section">
            <h3 class="text-center">Risultato della Predizione</h3>
            <div class="text-center mb-4">
                <h2 id="predictionResult" class="display-6"></h2>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <h5>Probabilità di Approvazione</h5>
                    <div class="probability-bar">
                        <div class="probability-value" id="probabilityValue">0%</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <h5>Dettagli Probabilità</h5>
                    <ul class="list-group">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Rifiutato:</span>
                            <span id="probRejected">0%</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Approvato:</span>
                            <span id="probApproved">0%</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="mt-4">
                <h5>Fattori Chiave</h5>
                <div id="keyFactors" class="alert alert-info">
                    <!-- I fattori chiave saranno inseriti qui dinamicamente -->
                </div>
            </div>

            <div class="text-center mt-3">
                <button id="resetBtn" class="btn btn-outline-secondary">Nuova Predizione</button>
            </div>
        </div>

        <!-- Loading Spinner -->
        <div id="loadingSpinner" class="text-center mt-4" style="display: none;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Calcolando...</span>
            </div>
            <p class="mt-2">Calcolando la predizione...</p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ url_for('static', filename='js/app.js') }}"></script>
</body>
</html>
